{
  "name": "@falcon-mcp/shared",
  "version": "0.0.0",
  "description": "Shared TypeScript utilities for falcon-mcp packages",
  "type": "module",
  "private": true,
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
