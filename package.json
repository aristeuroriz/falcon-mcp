{
  "name": "falcon-mcp",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "check-types": "turbo run check-types",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "pnpm build && pnpm changeset publish",
    "tag-releases": "node scripts/tag-releases.mjs",
    "mcp-config": "node scripts/mcp-config.mjs",
    "test:mcp-config": "node --test tests/mcp-config.test.mjs",
    "publish:katex:dry": "pnpm --filter @aristeuroriz/mcp-katex-validator publish --dry-run --access public --no-git-checks",
    "publish:katex": "pnpm --filter @aristeuroriz/mcp-katex-validator publish --access public"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Aristeu Roriz Neto <aristeuroriz@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/aristeuroriz/falcon-mcp"
  }
}
